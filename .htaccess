# ==============================================================================
# .HTACCESS PARA LA CARPETA DEL CATÁLOGO DE REPUESTOS (/repuestos/)
# ==============================================================================

# Página principal
DirectoryIndex index.html

# Apagar listado de directorios
Options -Indexes

# Bloquear acceso a archivos sensibles y de base de datos
<FilesMatch "\.(sqlite|sqlite-shm|sqlite-wal|env|log|md|jsonl)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Proteger el código fuente de node si se aloja en Apache
<Files "server.js">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Si Apache atiende una petición a la API de productos, devolver products.json
  RewriteRule ^api/products/?$ products.json [L]

  # Responder 204 a api/config si no hay backend activo
  RewriteRule ^api/config/?$ - [R=204,L]
</IfModule>

# Tipos MIME y compresión básica
<IfModule mod_mime.c>
  AddType application/json .json
  AddType image/svg+xml .svg
</IfModule>
